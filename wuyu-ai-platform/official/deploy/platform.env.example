WUYU_DATA=/var/lib/wuyu
WUYU_ALLOWED_ORIGINS=https://ai.example.com
WUYU_SECURE_COOKIE=1
# Secrets may be configured through the administrator UI; blank fields retain them.
# WUYU_MODEL_API_KEY=
# METASO_API_KEY=
# Optional voice credentials; values override encrypted administrator settings.
# WUYU_VOICE_APP_ID=
# WUYU_VOICE_API_KEY=
# WUYU_VOICE_API_SECRET=
# Optional HTTP tool credential: WUYU_TOOL_<UPPERCASE_TOOL_ID>_KEY=
